[Unit]
Description=PVE VM Studio
After=network-online.target
Wants=network-online.target

[Service]
User=pve-vm-studio
Group=pve-vm-studio
Environment=PVS_CONFIG=/etc/pve-vm-studio/config.toml
ExecStart=/usr/local/bin/pve-vm-studio
Restart=on-failure
RestartSec=5
# 443 and 80 without root: this one capability, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pve-vm-studio

[Install]
WantedBy=multi-user.target
