[Unit]
Description=PVE VM Studio: this machine's AIDE database (first boot of a clone)
ConditionPathExists=!/var/lib/aide/aide.db
ConditionPathExists=/usr/sbin/aideinit
After=local-fs.target

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# Its log files under /var/log/aide stay 0640 (6.1.3.1).
UMask=0027
TimeoutStartSec=0
ExecStart=/usr/sbin/aideinit -y -f

[Install]
WantedBy=multi-user.target
