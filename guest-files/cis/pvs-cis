#!/bin/bash
# pvs-cis - applies and checks a CIS Benchmark inside the guest (PVE VM Studio).
#
#   pvs-cis fix   --level 1|2 [--exceptions FILE] [--only ID,ID]
#   pvs-cis check --level 1|2 [--exceptions FILE] [--only ID,ID] [--json FILE]
#   pvs-cis list
#
# The benchmark is picked by /etc/os-release. Exceptions: one "ID<TAB>reason" per line -
# fix leaves those rules alone, check still runs them and reports "exception".
set -u
LIB=${PVS_CIS_LIB:-/usr/local/lib/pvs-cis}
# shellcheck source=lib.sh
. "$LIB/lib.sh"
# shellcheck disable=SC1091
. /etc/os-release

BENCH_DIR=""
for d in "$LIB"/*/; do
    [ -f "$d/bench.conf" ] || continue
    # DISTRO: one or more ID-VERSION_ID patterns (Enterprise Linux has minor versions: rocky-9.*).
    # shellcheck disable=SC2254
    if (. "$d/bench.conf"; set -f; for p in $DISTRO; do case ${PVS_CIS_DISTRO:-$ID-$VERSION_ID} in $p) exit 0 ;; esac; done; exit 1); then BENCH_DIR=$d; fi
done
[ -n "$BENCH_DIR" ] || { echo "pvs-cis: no benchmark for $ID $VERSION_ID" >&2; exit 2; }
# BENCHMARK, VERSION, DISTRO, FAMILY; MAP when the map is shared (Alma, Oracle and Rocky 9
# are one text: el9/map.tsv).
MAP=""
# shellcheck disable=SC1091
. "$BENCH_DIR/bench.conf"
MAP_FILE=$BENCH_DIR/map.tsv
[ -z "$MAP" ] || MAP_FILE=$LIB/$MAP/map.tsv

# The family's rules are keyed by what they check (rule <key> "<title>"); the benchmark's
# map.tsv says which of them it has, under which number, at which level - the numbers move
# between benchmark versions, the checks do not.
declare -A K_TITLE
rule() { K_TITLE[$1]=$2; }
# FAMILY may name several folders: later ones add rules and redefine the functions that
# differ (el on top of deb: dnf, SELinux, firewalld, authselect).
for fam in ${FAMILY:?bench.conf sets FAMILY}; do
    for f in "$LIB/$fam"/[0-9]*.sh; do
        [ -f "$f" ] || continue
        # shellcheck disable=SC1090
        . "$f"
    done
done
# The site's own values (the studio's CIS settings, kept with the gold): "Key<TAB>value" in
# $LIB/site. Banner: the login banner (/etc/issue, /etc/issue.net, /etc/motd, sshd);
# Ntp: the authorized time servers, space-separated (empty: the distro's).
if [ -f "$LIB/site" ]; then
    while IFS=$'\t' read -r k v; do
        case $k in
            Banner) [ -n "$v" ] && C1B_BANNER=$v ;;
            Ntp) [ -n "$v" ] && PVS_CIS_NTP=$v ;;
        esac
    done < "$LIB/site"
fi
RULES=()
declare -A R_LEVEL R_KIND R_TITLE R_KEY
while IFS=$'\t' read -r id lvl kind key; do
    case $id in ''|'#'*) continue ;; esac
    RULES+=("$id")
    R_LEVEL[$id]=$lvl
    R_KIND[$id]=$kind
    R_KEY[$id]=$key
    R_TITLE[$id]=${K_TITLE[$key]:-$key}
done < "$MAP_FILE"

cmd=${1:-}
shift || true
LEVEL=1
EXC_FILE=""
ONLY=""
JSON=""
while [ $# -gt 0 ]; do
    case $1 in
        --level) LEVEL=$2; shift 2 ;;
        --exceptions) EXC_FILE=$2; shift 2 ;;
        --only) ONLY=",$2,"; shift 2 ;;
        --json) JSON=$2; shift 2 ;;
        *) echo "pvs-cis: unknown option $1" >&2; exit 2 ;;
    esac
done
declare -A EXC EXC_FIX
# The benchmark's own (exceptions.default beside bench.conf: what the studio deviates from on
# purpose, with the reason - e.g. HMAC-SHA1 kept for Kerberos on Leap), then the bake's.
# A third column "fix": the deviation is partial - the fix still does all it can (the check
# then fails with rc 4 on anything beyond the reason).
for ef in "$BENCH_DIR/exceptions.default" "$EXC_FILE"; do
    [ -n "$ef" ] && [ -f "$ef" ] || continue
    while IFS=$'\t' read -r id why flag; do
        case $id in ''|'#'*) continue ;; esac
        EXC[$id]=${why:-no reason given}
        [ "${flag:-}" = fix ] && EXC_FIX[$id]=1
    done < "$ef"
done

# Who reads a line decides its form. The bake pipes pvs-cis and reads the CIS-* markers
# (src/golds.rs, bake/finish.sh), so off a terminal they stay exactly as they are. An admin at
# a terminal gets the studio's log layout (deploy/install.sh log()): time, a five-wide tag,
# the message, in the Kaido (Tokyo Night) colours.
say() { # <fd> <tag> <marker line> <human line>
    local fd=$1 tag=$2 shown color
    if [ ! -t "$fd" ]; then
        printf '%s\n' "$3" >&"$fd"
        return
    fi
    shown=$tag
    [ "$tag" = ok ] && shown="o.k."
    if [ -n "${NO_COLOR:-}" ]; then
        printf ' %s [ %-5s ] %s\n' "$(date '+%H:%M:%S')" "$shown" "$4" >&"$fd"
        return
    fi
    case $tag in
        start|end) color=$'\e[38;2;122;162;247m' ;; info) color=$'\e[38;2;230;222;120m' ;;
        warn) color=$'\e[38;2;224;175;104m' ;; ok) color=$'\e[38;2;158;206;106m' ;;
        error) color=$'\e[38;2;247;118;142m' ;; *) color=$'\e[38;2;139;147;173m' ;;
    esac
    printf ' \e[38;2;139;147;173m%s [ \e[0m%s%-5s\e[0m\e[38;2;139;147;173m ]\e[0m %s\n' \
        "$(date '+%H:%M:%S')" "$color" "$shown" "$4" >&"$fd"
}

# The functions of a recommendation: check_<key>/fix_<key>, dashes as underscores.
fname() { local k=${R_KEY[$1]}; echo "${k//-/_}"; }

# The rules of the profile, in file order.
selected() {
    local id
    for id in "${RULES[@]}"; do
        [ "${R_LEVEL[$id]}" -le "$LEVEL" ] || continue
        [ -z "$ONLY" ] || [[ "$ONLY" == *",$id,"* ]] || continue
        echo "$id"
    done
}

# JSON string: backslash, quote, newline, tab; other control characters dropped.
js() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/}
    s=${s//$'\n'/\\n}
    printf '"%s"' "$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037')"
}

do_fix() {
    local id f out rc ok=0 failed=0 none=0
    for id in $(selected); do
        f=fix_$(fname "$id")
        if [ -n "${EXC[$id]+x}" ] && [ -z "${EXC_FIX[$id]+x}" ]; then
            say 1 info "CIS-FIX $id exception" "$id exception, left alone: ${EXC[$id]}"
            continue
        fi
        if ! declare -F "$f" >/dev/null; then
            none=$((none + 1))
            continue
        fi
        out=$( ("$f") 2>&1 )
        rc=$?
        if [ $rc -eq 0 ]; then
            ok=$((ok + 1))
        else
            failed=$((failed + 1))
            say 1 error "CIS-FIX-FAILED $id rc=$rc ${R_TITLE[$id]}" "$id fix failed (rc $rc): ${R_TITLE[$id]}"
            [ -n "$out" ] && printf '%s\n' "$out" | tail -n 5 | sed 's/^/  | /'
        fi
    done
    say 1 "$([ $failed -eq 0 ] && echo ok || echo error)" "CIS-FIX-DONE level $LEVEL: $ok applied, $failed failed, $none without a fix" \
        "fix level $LEVEL: $ok applied, $failed failed, $none without a fix"
}

do_check() {
    local id f out rc status pass=0 fail=0 na=0 review=0 exc=0 err=0 first=1 tmp
    tmp=$(mktemp)
    for id in $(selected); do
        f=check_$(fname "$id")
        if declare -F "$f" >/dev/null; then
            out=$( ("$f") 2>&1 )
            rc=$?
        else
            out="no check for this rule"
            rc=9
        fi
        case $rc in
            0) status=pass ;;
            1) status=fail ;;
            2) status=na ;;
            3) status=review ;;
            # A fail beyond what the rule's exception covers (the check knows what that is):
            # never shown as the exception.
            4) status=fail ;;
            *) status=error ;;
        esac
        # Only a plain fail becomes the declared exception - an error or a review stays what it is.
        if [ -n "${EXC[$id]+x}" ] && [ "$rc" = 1 ]; then status=exception; fi
        case $status in
            pass) pass=$((pass + 1)) ;; fail) fail=$((fail + 1)) ;; na) na=$((na + 1)) ;;
            review) review=$((review + 1)) ;; exception) exc=$((exc + 1)) ;; *) err=$((err + 1)) ;;
        esac
        case $status in
            pass) ;;
            fail|error) say 2 error "CIS-$status $id ${R_TITLE[$id]}" "$id $status: ${R_TITLE[$id]}" ;;
            exception) say 2 warn "CIS-$status $id ${R_TITLE[$id]}" "$id exception: ${R_TITLE[$id]} - ${EXC[$id]}" ;;
            *) say 2 info "CIS-$status $id ${R_TITLE[$id]}" "$id $status: ${R_TITLE[$id]}" ;;
        esac
        out=${out:0:2000}
        {
            [ $first -eq 1 ] || printf ',\n'
            first=0
            printf '  {"id":%s,"key":%s,"level":%s,"kind":%s,"title":%s,"status":%s,"evidence":%s' \
                "$(js "$id")" "$(js "${R_KEY[$id]}")" "${R_LEVEL[$id]}" "$(js "${R_KIND[$id]}")" "$(js "${R_TITLE[$id]}")" "$(js "$status")" "$(js "$out")"
            [ -n "${EXC[$id]+x}" ] && printf ',"reason":%s' "$(js "${EXC[$id]}")"
            printf '}'
        } >> "$tmp"
    done
    local summary
    summary=$(printf '"pass":%d,"fail":%d,"na":%d,"review":%d,"exception":%d,"error":%d' $pass $fail $na $review $exc $err)
    if [ -n "$JSON" ]; then
        {
            printf '{"benchmark":%s,"version":%s,"distro":%s,"level":%s,"profile":%s,"checked":%s,"host":%s,\n' \
                "$(js "$BENCHMARK")" "$(js "$VERSION")" "$(js "$DISTRO")" "$LEVEL" "$(js "level${LEVEL}_server")" \
                "$(js "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" "$(js "$(hostname)")"
            printf ' "counts":{%s},\n "results":[\n' "$summary"
            cat "$tmp"
            printf '\n]}\n'
        } > "$JSON"
    fi
    rm -f "$tmp"
    say 1 "$([ $((fail + err)) -eq 0 ] && echo ok || echo error)" \
        "CIS-CHECK-DONE level $LEVEL: $pass pass, $fail fail, $na n/a, $review review, $exc exception, $err error" \
        "check level $LEVEL: $pass pass, $fail fail, $na n/a, $review review, $exc exception, $err error"
}

case $cmd in
    fix) do_fix ;;
    check) do_check ;;
    list) for id in "${RULES[@]}"; do printf '%s\tL%s\t%s\t%s\t%s\n' "$id" "${R_LEVEL[$id]}" "${R_KIND[$id]}" "${R_TITLE[$id]}" "${R_KEY[$id]}"; done ;;
    *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
